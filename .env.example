# Copy to .env before running. .env is gitignored and never committed.
#
#   cp .env.example .env
#   docker compose up
#
# Every setting here reaches the application through backend/app/core/config.py,
# and no key is ever written into a source file.
#
# The values below are local development defaults, not secrets. Anything that
# is genuinely a secret is left blank.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=tube
POSTGRES_PASSWORD=tube
POSTGRES_DB=tube_router

# Host port only - inside the compose network Postgres is always on 5432, and
# DATABASE_URL below is unaffected. Deliberately not 5432: a developer machine
# frequently has a PostgreSQL of its own on that port, and then `docker
# compose up` fails on a fresh clone for a reason that has nothing to do with
# this project. This port exists for a GUI client, so its number is arbitrary.
POSTGRES_PORT=55432

# Host is `db` because that is the service name on the compose network.
# Running the API directly on your machine instead? Use localhost.
DATABASE_URL=postgresql+asyncpg://tube:tube@db:5432/tube_router

# The schema tests in backend/tests/models/test_schema.py need a real Postgres with
# PostGIS - they assert that the database rejects things, which cannot be
# faked. They are SKIPPED when this is unset, so `uv run pytest` still works
# with nothing running.
#
# This one is reached from your machine, not from inside the compose network,
# so it is localhost and the published port. The database itself is created by
# backend/initdb/01-create-test-database.sql when the db volume first
# initialises.
TEST_DATABASE_URL=postgresql+asyncpg://tube:tube@localhost:55432/tube_router_test

# --- Redis -------------------------------------------------------------------
# Caches the built network and carries live line status between API workers.
# Host port, as with Postgres above; 6379 inside the network regardless.
REDIS_PORT=56379
REDIS_URL=redis://redis:6379/0

# --- API ---------------------------------------------------------------------
API_PORT=8000

# Comma-separated. Never "*": a wildcard set for convenience tends to outlive
# the reason it was set.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173

# Read by Vite at build time. The browser resolves this, not the compose
# network, so it is localhost rather than the `api` service name.
VITE_API_URL=http://localhost:8000

# --- TfL -------------------------------------------------------------------
# Free from https://api-portal.tfl.gov.uk/. Name only; fill it in .env.
TFL_APP_KEY=

# --- Google Maps -----------------------------------------------------------
# Optional. Blank means the "Near <destination>" section never appears and
# nothing is requested - the app is otherwise unchanged, exactly as it is
# without a TfL key.
#
# Get one from https://console.cloud.google.com/, and restrict it to
# **Places API (New)**, **Street View Static API** and **Geocoding API**. An
# unrestricted key in a public repository's deployment is a bill somebody
# else runs up.
#
# It must be a plain API key, NOT one bound to a service account: bound keys
# only work with Vertex and Gemini, and every Maps endpoint rejects them as
# invalid. Maps keys are 39 characters and begin AIza.
GOOGLE_MAPS_KEY=
