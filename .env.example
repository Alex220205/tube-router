# Copy to .env before running. .env is gitignored and never committed.
#
#   cp .env.example .env
#   docker compose up
#
# The 2021 project hardcoded a Google Maps key at lines 239 and 276 and a TfL
# key at line 14 plus six other places. Every setting here reaches the
# application through backend/app/config.py instead, and nothing is written
# into a source file.
#
# The values below are local development defaults, not secrets. Anything that
# is genuinely a secret is left blank.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=tube
POSTGRES_PASSWORD=tube
POSTGRES_DB=tube_router

# Host port only — inside the compose network Postgres is always on 5432, and
# DATABASE_URL below is unaffected. Deliberately not 5432: a developer machine
# frequently has a PostgreSQL of its own on that port, and then `docker
# compose up` fails on a fresh clone for a reason that has nothing to do with
# this project. This port exists for a GUI client, so its number is arbitrary.
POSTGRES_PORT=55432

# Host is `db` because that is the service name on the compose network.
# Running the API directly on your machine instead? Use localhost.
DATABASE_URL=postgresql+asyncpg://tube:tube@db:5432/tube_router

# --- Redis -------------------------------------------------------------------
# Unused until Phase 6 (cached network) and Phase 7 (status pub/sub). The
# container runs from Phase 0 so the stack is complete from the start.
# Host port, as with Postgres above; 6379 inside the network regardless.
REDIS_PORT=56379
REDIS_URL=redis://redis:6379/0

# --- API ---------------------------------------------------------------------
API_PORT=8000

# Comma-separated. Never "*": a wildcard set in Phase 0 is still there in
# Phase 9, on a public repository.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173

# Read by Vite at build time. The browser resolves this, not the compose
# network, so it is localhost rather than the `api` service name.
VITE_API_URL=http://localhost:8000

# --- TfL (Phase 7) -----------------------------------------------------------
# Free from https://api-portal.tfl.gov.uk/. Name only; fill it in .env.
TFL_APP_KEY=
