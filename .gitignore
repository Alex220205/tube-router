# --- Secrets -----------------------------------------------------------------
# .env holds real credentials and API keys. Only .env.example is tracked.
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node --------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# --- Data --------------------------------------------------------------------
# The 2021 SQLite database is read by seed.py in Phase 2 but never committed.
*.db
*.sqlite
*.sqlite3
data/

# --- Reference material ------------------------------------------------------
# The 2021 project, kept locally to audit against and to seed from in Phase 2.
# Deliberately not part of this repository. It contains hardcoded API keys -
# a TfL key and a Google Maps key - and committing it would copy them into
# this history too, where they would be exposed the moment the repo goes
# public. Read from, never tracked.
old_source_code/

# --- Test and build artefacts ------------------------------------------------
# Nothing here is produced yet. Listed now so the first time a tool writes one
# it is already ignored, rather than being noticed in a diff later.
.coverage.*
coverage.xml
.eslintcache
*.tsbuildinfo
playwright-report/
test-results/

# --- Logs and local state ----------------------------------------------------
*.log
*.pid
.claude/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
